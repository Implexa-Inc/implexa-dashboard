  "provenance": {
    "producedBy": null,
    "note": "ASSUMED, NOT PRODUCED. The backend F0 (spec §5) is being built in parallel and owns the real routes, payloads and fixtures. Every shape below is this repository's assumption, written before the producer existed, so the two can be diffed. `npm run fixtures:training-review:check` FAILS while `producedBy` is null — an unverified provenance claim is worse than no claim. When the backend lands, regenerate from it and set `producedBy` to the exact commit."
  },
  "upstream": {
    "base": "/api/v2/agents/training",
    "actions": {
      "ensure_training_session": {
        "method": "POST",
        "path": "/api/v2/agents/training/sessions/{trainingSessionId}/review-sessions",
        "body": { "sourceId": "uuid", "contractVersion": "agent-training-review.v1" }
      },
      "create_training_annotation": {
        "method": "POST",
        "path": "/api/v2/agents/training/review-sessions/{reviewSessionId}/annotations",
        "body": {
          "sourceId": "uuid",
          "temporalRange": { "startMs": "int", "endMs": "int|null" },
          "coachText": "string(1..4000)",
          "anchorDigest": "sha256",
          "spatialRegion": "object|null",
          "transcriptSpan": "object|null",
          "contractVersion": "agent-training-review.v1"
        }
      },
      "amend_training_annotation": {
        "method": "POST",
        "path": "/api/v2/agents/training/review-annotations/{annotationId}/amend",
        "body": {
          "coachText": "string(1..4000)",
          "temporalRange": "range|null",
          "spatialRegion": "object|null",
          "transcriptSpan": "object|null",
          "contractVersion": "agent-training-review.v1"
        },
        "note": "Append-only. The server mints a successor annotation naming what it supersedes; it never rewrites the row."
      },
      "discard_training_annotation": {
        "method": "POST",
        "path": "/api/v2/agents/training/review-annotations/{annotationId}/discard",
        "body": { "contractVersion": "agent-training-review.v1" }
      },
      "attach_training_evidence": {
        "method": "POST",
        "path": "/api/v2/agents/training/review-annotations/{annotationId}/evidence",
        "body": {
          "kind": "clip|frame|transcript",
          "mediaSha256": "sha256",
          "temporalRange": { "startMs": "int", "endMs": "int|null" },
          "custody": "local_only",
          "contractVersion": "agent-training-review.v1"
        }
      },
      "submit_training_annotations": {
        "method": "POST",
        "path": "/api/v2/agents/training/review-sessions/{reviewSessionId}/submissions",
        "body": {
          "annotationIds": ["uuid"],
          "recordingDigest": "sha256",
          "contractVersion": "agent-training-review.v1"
        }
      },
      "confirm_training_decision": {
        "method": "POST",
        "path": "/api/v2/agents/training/submissions/{submissionId}/decisions/{decisionId}/confirm",
        "body": {
          "disposition": "accepted|edited|merged|discarded",
          "mergedIntoDecisionId": "uuid|null",
          "edits": "object|null",
          "activate": false,
          "contractVersion": "agent-training-review.v1"
        },
        "note": "`activate` is pinned false by the resolver. F0 has no expression that can request activation."
      },
      "read_training_projection": {
        "method": "GET",
        "path": "/api/v2/agents/training/sessions/{trainingSessionId}/projection?sourceId={sourceId}"
      }
    }
  },
