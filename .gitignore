# Dependencies
# Both spellings, deliberately. `node_modules/` matches only a real DIRECTORY;
# a node_modules SYMLINK (worktrees sharing one install) slips past it and gets
# committed — which is exactly how one reached this branch.
node_modules
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Environment files — secrets, NEVER commit
.env
.env*.local
.env.development.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel/

# Editor / OS
.DS_Store
*.pem
.vscode/
.idea/
*.swp

# Testing
coverage/
.nyc_output/
.vercel
