# ── Implexa dashboard env template ────────────────────────────────
# Copy to .env.local. Never commit .env.local.

# ── Supabase (public — these go to the browser) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ── Implexa backend (public base URL) ─────────────────────────────
NEXT_PUBLIC_IMPLEXA_API_URL=http://localhost:8001

# ── Workflow catalog read (server-only) ───────────────────────────
# Token for the backend's public read-only MCP tools (list_workflows /
# get_workflow) that power the /workflows view. The workflow catalog lives in
# Supabase aggregated_skills, which is service-role-only RLS, so the dashboard
# cannot read it with the anon client; it reads through the backend instead,
# exactly as implexa.ai/workflows does. Same value as the marketing site's
# IMPLEXA_PUBLIC_SEARCH_TOKEN. When unset, /workflows shows its empty state.
IMPLEXA_PUBLIC_SEARCH_TOKEN=
